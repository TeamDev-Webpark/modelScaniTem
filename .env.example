# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/model_stcan_item

# Admin app
SECRET_KEY=<long-random-string>
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=<choose-a-strong-password>

# Folder for uploaded images, trained models and exports (relative to the project root)
DATA_DIR=admin_data

# Optional: folder with the raw Yamaha photos (used as the default photo folder by scripts/)
YAMAHA_DATA_DIR=C:/MyProject/Webpark/dataYamaha
